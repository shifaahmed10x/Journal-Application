<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<!-- Maven model version -->
	<modelVersion>4.0.0</modelVersion>


	<!-- =========================================================
         PROJECT INFORMATION
         ========================================================= -->

	<!-- Spring Boot parent manages compatible dependency versions -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/>
	</parent>

	<groupId>com.ahmed</groupId>
	<artifactId>journalApp</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<name>journalApp</name>
	<description>Journal Application using Spring Boot and MongoDB</description>


	<!-- =========================================================
         JAVA VERSION
         ========================================================= -->

	<properties>
		<!-- Project is using Java 21 -->
		<java.version>21</java.version>
	</properties>


	<!-- =========================================================
         DEPENDENCIES
         ========================================================= -->

	<dependencies>

		<!-- Spring MVC / REST API
             Provides:
             - @RestController
             - @GetMapping
             - @PostMapping
             - @RequestBody
             - Embedded Tomcat
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>


		<!-- MongoDB
             Provides:
             - MongoRepository
             - MongoTemplate
             - @Document
             - @Id
             - MongoDB connection
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-mongodb</artifactId>
		</dependency>


		<!-- Spring Security
             Provides:
             - Authentication
             - Authorization
             - Password handling
             - Security filters
        -->
		<!-- Version is intentionally NOT specified.
             Spring Boot manages the compatible version. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>


		<!-- Swagger / OpenAPI
             Provides:
             - Swagger UI
             - API documentation
             - Interactive API testing
        -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.10</version>
		</dependency>

		<!-- Lombok
             Reduces boilerplate code:
             - @Data
             - @Getter
             - @Setter
             - @NoArgsConstructor
             - @RequiredArgsConstructor
        -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>


		<!-- Spring Boot testing support -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>


	<!-- =========================================================
         BUILD CONFIGURATION
         ========================================================= -->

	<build>
		<plugins>

			<!-- Spring Boot Maven Plugin
                 Used to:
                 - Run Spring Boot application
                 - Package application as JAR
                 - Create executable JAR
            -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>

				<configuration>

					<!-- Lombok is only needed during compilation,
                         so it is excluded from the final JAR. -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>

				</configuration>
			</plugin>


			<!-- Maven Compiler Plugin
                 Handles Java compilation and Lombok annotation processing.
            -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>

				<executions>

					<!-- Compile main source code -->
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>

						<goals>
							<goal>compile</goal>
						</goals>

						<configuration>

							<!-- Tells Maven to use Lombok
                                 during compilation -->
							<annotationProcessorPaths>

								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>

							</annotationProcessorPaths>

						</configuration>
					</execution>


					<!-- Compile test source code -->
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>

						<goals>
							<goal>testCompile</goal>
						</goals>

						<configuration>

							<!-- Lombok annotation processing for tests -->
							<annotationProcessorPaths>

								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>

							</annotationProcessorPaths>

						</configuration>
					</execution>

				</executions>
			</plugin>

		</plugins>
	</build>

</project>